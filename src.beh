params [
    Cargo,
    Targets,    -- renamed from param2: list of drop-off targets
    param3,
    param4,
]

vars [
    State = 0,  -- 0=SEARCHING, 1=LOADING, -1=UNLOADING
    Entity,
    Signal,
    Items,
    Closest,
]

------------------- start -----------------

turnOn()
lockSlots(Cargo)
State = 0
unlock()

repeat

    compare(State, 0)

        equal
            Entity, Signal = foreach(Cargo)
                if Signal > 0 then
                    State = 1
                    break
                end
            end
        end

        larger
            Entity, Signal = foreach(Cargo)
                if Signal > 0 then
                    pickItems(Entity)
                    if not checkFreeSpace(Cargo) then
                        State = -1
                    end
                    break
                end
            end
            wait(300)
        end

        smaller
            Closest = findClosest(Cargo, Targets)
            dropItems(Closest)
            Items = countItems()
            Items = -1 * Items
            State = Items
        end

    end

    wait(1)

end

function findClosest (Arg1, Arg2)
    vars (Closest RoomForItems Nearest Var4 Var5)

    -- First pass: find any valid target with free space
    Var4, Var5 = foreach(Arg2)
        if Var5 < 0 then
            RoomForItems = getFreeSpace(Var4, Arg1)
            if RoomForItems > 0 then
                Closest = Var4
                break
            end
        end
    end

    -- Second pass: narrow down to the nearest valid target
    Var4, Var5 = foreach(Arg2)
        if Var5 < 0 then
            RoomForItems = getFreeSpace(Var4, Arg1)
            if RoomForItems > 0 then
                Nearest = nearest(Closest, Var4)
                Closest = Nearest
            end
        end
    end

    return Closest, Nearest
end