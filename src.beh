params [
    Cargo,
    param2,
    param3,
    param4
]

var State = 0
var Entity
var Signal
var Items
var Closest

------------------- start -----------------

turnOn()
lockSlots(Cargo)
State = 0   --STATES \"A\".			   0=SEARCHING.			   1=LOADING.			   -1=UNLOADING
unlock()

repeat

    compare(State, 0)

        equal
            Entity, Signal = foreach(Cargo)
                if Signal > 0 then
                    State = 1
                    break   --break from the loopSignal
                end
            end
        end

        larger
            Entity, Signal = foreach(Cargo)
                if Signal > 0 then
                    pickItems(Entity)
                        if not checkFreeSpace(Cargo) then
                            State = -1
                        end
                        break   --break from the loopSignal
                end
            end
            wait(300)   -- wait for 300 ticks without changing state
        end

        smaller
            Closest = foreach(param1, param2) end;
            dropItems(Closest)
            Items = countItems()
            Items = -1 * Items
            State = Items
        end
    end
end

wait(1)
goto(MAIN_LOOP)

function findClosest (Arg1, Arg2)
    var Var1, Var2, Var3

    var Var4, Var5 = foreach(Cargo)
        if Var5 < 0 then
            RoomForItems = getFreeSpace(Var4, Var5)
            if RoomForItems > 0 then
                Closest = Var4
                break   --break from the loopVar5
            end
        end
    end

    Var4, Var5 = foreach(Cargo)
        if Var5 < 0 then
            RoomForItems = getFreeSpace(Var4, Var5)
            if RoomForItems > 0 then
                Var1 = nearest(Closest, Var4)
                Closest = Var1
            end
        end
    end

    return Arg1, Var1
end
