{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Behavior",
  "scopeName": "source.beh",
  "patterns": [
    { "include": "#block" },
    { "include": "#functionsDefine" }
  ],
  "repository": {
    "block": {
      "patterns": [
        {
          "name": "meta.block.beh",
          "patterns": [
            {
              "name": "meta.declaration.params.beh",
              "begin": "\\bparams\\s*\\[",
              "beginCaptures": {
                "0": { "name": "keyword.declaration.params.beh" }
              },
              "end": "\\]",
              "patterns": [
                { "include": "#comments" },
                {
                  "name": "variable.other.block.beh",
                  "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*(\\s*=\\s*\\d+)?\\b"
                }
              ]
            },
            {
              "name": "meta.declaration.vars.beh",
              "begin": "\\bvar[s]?\\s*\\[",
              "beginCaptures": {
                "0": { "name": "keyword.declaration.vars.beh" }
              },
              "end": "\\]",
              "patterns": [
                { "include": "#comments" },
                {
                  "name": "variable.other.block.beh",
                  "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*(\\s*=\\s*-?\\d+)?\\b"
                }
              ]
            },
            { "include": "#comments" },
            { "include": "#multiAssign" },
            { "include": "#foreachLoop" },
            { "include": "#compareBlock" },
            { "include": "#ifStatement" },
            { "include": "#keywords" },
            { "include": "#operators" },
            { "include": "#labelCall" },
            { "include": "#functionsCall" },
            { "include": "#returnStatement" },
            { "include": "#numbers" },
            { "include": "#strings" },
            {
              "name": "variable.other.block.beh",
              "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
            }
          ]
        }
      ]
    },
    "functionsDefine": {
      "patterns": [
        {
          "name": "meta.function.definition.beh",
          "begin": "\\b(function)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*\\(",
          "beginCaptures": {
            "1": { "name": "keyword.control.function.beh" },
            "2": { "name": "entity.name.function.beh" }
          },
          "end": "\\bend\\b",
          "endCaptures": {
            "0": { "name": "keyword.control.end.beh" }
          },
          "patterns": [
            { "include": "#block" }
          ]
        }
      ]
    },
    "multiAssign": {
      "patterns": [
        {
          "comment": "Multi-assign: Var1, Var2 = expr",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*,\\s*([a-zA-Z_][a-zA-Z0-9_]*)\\s*=",
          "captures": {
            "1": { "name": "variable.other.assignment.beh" },
            "2": { "name": "variable.other.assignment.beh" }
          }
        }
      ]
    },
    "labelCall": {
      "patterns": [
        {
          "comment": "goto(LABEL) or label(LABEL) - highlight label as constant",
          "match": "\\b(goto|label)\\s*\\(\\s*([a-zA-Z_][a-zA-Z0-9_]*)\\s*\\)",
          "captures": {
            "1": { "name": "keyword.control.beh" },
            "2": { "name": "constant.other.label.beh" }
          }
        }
      ]
    },
    "functionsCall": {
      "patterns": [
        {
          "name": "meta.function.call.important.beh",
          "begin": "\\b(_[a-zA-Z][a-zA-Z0-9_]*)\\s*\\(",
          "beginCaptures": {
            "1": { "name": "entity.name.function.important.beh" }
          },
          "end": "\\)",
          "patterns": [
            { "include": "#comments" },
            { "include": "#numbers" },
            { "include": "#strings" },
            { "include": "#operators" },
            { "include": "#functionsCall" },
            {
              "name": "variable.other.block.beh",
              "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
            }
          ]
        },
        {
          "name": "meta.function.call.beh",
          "begin": "\\b([a-zA-Z][a-zA-Z0-9_]*)\\s*\\(",
          "beginCaptures": {
            "1": { "name": "entity.name.function.builtin.beh" }
          },
          "end": "\\)",
          "patterns": [
            { "include": "#comments" },
            { "include": "#numbers" },
            { "include": "#strings" },
            { "include": "#operators" },
            { "include": "#functionsCall" },
            {
              "name": "variable.other.block.beh",
              "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
            }
          ]
        }
      ]
    },
    "returnStatement": {
      "patterns": [
        {
          "name": "meta.return.beh",
          "begin": "\\breturn\\s*\\(",
          "beginCaptures": {
            "0": { "name": "keyword.control.return.beh" }
          },
          "end": "\\)",
          "patterns": [
            {
              "name": "variable.other.block.beh",
              "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
            }
          ]
        },
        {
          "name": "keyword.control.return.beh",
          "match": "\\breturn\\b"
        }
      ]
    },
    "compareBlock": {
      "patterns": [
        {
          "name": "meta.compare.beh",
          "begin": "\\b(compare)\\s*\\(",
          "beginCaptures": {
            "1": { "name": "keyword.control.compare.beh" }
          },
          "end": "\\bend\\b",
          "endCaptures": {
            "0": { "name": "keyword.control.end.beh" }
          },
          "patterns": [
            { "include": "#block" }
          ]
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.beh",
          "match": "\\b(if|else|true|false|end|break|wait|repeat|for|while|equal|larger|smaller|do|then|not|and|or|foreach|function)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.beh",
          "match": "(\\b(and|or|not)\\b|==|~=|<=|>=|<|>|\\+|\\-|\\*|\\/|\\^|%|=)"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.beh",
          "match": "-?\\b\\d+\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.beh",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.beh",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.beh",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.beh",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-dash.beh",
          "match": "--.*$"
        }
      ]
    },
    "foreachLoop": {
      "patterns": [
        {
          "name": "meta.foreach.beh",
          "begin": "\\b(foreach)\\s*\\(",
          "beginCaptures": {
            "1": { "name": "keyword.control.foreach.beh" }
          },
          "end": "\\bend\\b",
          "endCaptures": {
            "0": { "name": "keyword.control.end.beh" }
          },
          "patterns": [
            { "include": "#block" }
          ]
        }
      ]
    },
    "ifStatement": {
      "patterns": [
        {
          "name": "meta.if.beh",
          "begin": "\\b(if)\\b",
          "beginCaptures": {
            "1": { "name": "keyword.control.if.beh" }
          },
          "end": "\\bend\\b",
          "endCaptures": {
            "0": { "name": "keyword.control.end.beh" }
          },
          "patterns": [
            { "include": "#block" }
          ]
        }
      ]
    }
  }
}
