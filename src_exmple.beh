local ore = "Metal Ore"

params [
    Cargo,
    Targets,
    param3,
    param4,
]

var State = 0
var Entity
var Signal
var Items
var Closest

------------------- start -----------------

turnOn()
lockSlots(Cargo)
State = 0
unlock()

repeat

    checkNumber(State, 0)

        equal
            Entity, Signal = forSignalMatch(Cargo)
                if Signal > 0 then
                    State = 1
                    break
                end
            end
        end

        larger
            Entity, Signal = forSignalMatch(Cargo)
                if Signal > 0 then
                    pickItems(Entity)
                    if not checkFreeSpace(Cargo, ore) then
                        State = -1
                    end
                    break
                end
            end
            wait(300)
        end

        smaller
            Closest = findClosest(Cargo, Targets)
            Result = getItemInfo(Closest)
            Items = countItems()
            Items = -1 * Items
            State = Items
        end

    end

    wait(1)

end

function findClosest (Arg1, Arg2)
    var Closest
    var RoomForItems
    var Nearest
    var Var4
    var Var5

    Var4, Var5 = forSignalMatch(Arg2)
        if Var5 < 0 then
            RoomForItems = getFreeSpace(Var4, Arg1)
            if RoomForItems > 0 then
                Closest = Var4
                break
            end
        end
    end

    Var4, Var5 = forSignalMatch(Arg2)
        if Var5 < 0 then
            RoomForItems = getFreeSpace(Var4, Arg1)
            if RoomForItems > 0 then
                Nearest = nearest(Closest, Var4)
                Closest = Nearest
            end
        end
    end

    return Closest, Nearest
end
